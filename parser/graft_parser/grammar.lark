// GQL -- Graft Query Language grammar (Lark EBNF)
// Normative. Must stay in sync with parser/SPECS.md s3.
// Parser: earley, ambiguity=resolve.
//
// Design note: uses left-recursive rules (no group quantifiers)
// so the grammar is unambiguous to Lark's earley parser.

// ---- Query root -----------------------------------------------------------
// Eight alternatives cover all combinations of optional WHERE / ORDER BY / LIMIT.
// Left-recursive style is preserved — no group quantifiers.

query : "from" entity_path "as" IDENT "select" projection
      | "from" entity_path "as" IDENT "select" projection order_by
      | "from" entity_path "as" IDENT "select" projection limit
      | "from" entity_path "as" IDENT "select" projection order_by limit
      | "from" entity_path "as" IDENT "where" condition "select" projection
      | "from" entity_path "as" IDENT "where" condition "select" projection order_by
      | "from" entity_path "as" IDENT "where" condition "select" projection limit
      | "from" entity_path "as" IDENT "where" condition "select" projection order_by limit

// ---- ORDER BY + LIMIT ----------------------------------------------------

order_by    : "order" "by" order_items

order_items : order_item                    -> orderitems_single
            | order_items "," order_item    -> orderitems_chain

order_item  : field                         -> order_item_default
            | field ORDER_DIR               -> order_item_dir

ORDER_DIR   : "asc" | "desc"

limit       : "limit" POS_INT               -> limit_clause

POS_INT     : /[1-9][0-9]*/

// ---- Entity path (left-recursive) ----------------------------------------

entity_path : ROOT_ENTITY                  -> entity_root
            | entity_path "." traversal    -> entity_chain

ROOT_ENTITY : "function"
            | "class"
            | "file"
            | "expression"

traversal   : IDENT "(" ")"         -> pred_noargs
            | IDENT "(" arglist ")" -> pred_args
            | IDENT                 -> field_traversal

arglist     : arg                   -> arglist_single
            | arglist "," arg       -> arglist_chain

arg         : STRING                -> arg_string
            | NUMBER                -> arg_number
            | NULL_KW               -> arg_null

// ---- Condition (left-recursive) ------------------------------------------

condition   : expr                      -> cond_single
            | condition BOOL_OP expr    -> cond_chain

BOOL_OP     : "and" | "or"

expr        : field OP value            -> binary_expr
            | field "like" STRING       -> like_expr
            | "not" expr                -> not_expr
            | "(" condition ")"         -> grouped_expr

field       : IDENT "." IDENT          -> field_root
            | field "." IDENT           -> field_chain

OP          : ">=" | "<=" | "!=" | "=" | ">" | "<"

value       : STRING                    -> val_string
            | NUMBER                    -> val_number
            | NULL_KW                   -> val_null
            | TRUE_KW                   -> val_true
            | FALSE_KW                  -> val_false
            | field                     -> val_field

// ---- Projection (left-recursive) -----------------------------------------

projection  : proj_item                     -> proj_single
            | projection "," proj_item      -> proj_chain

proj_item   : concat_item

concat_item : atom_item                     -> concat_single
            | concat_item "+" atom_item     -> concat_chain

atom_item   : field                         -> field_proj
            | STRING                        -> literal_proj

// ---- Terminals -----------------------------------------------------------

NULL_KW  : "null"
TRUE_KW  : "true"
FALSE_KW : "false"

// IDENT comes after keyword terminals so keywords win on overlap
IDENT    : /[a-zA-Z_][a-zA-Z0-9_]*/

STRING   : /\"(?:[^\"\\]|\\.)*\"/ | /\'(?:[^\'\\]|\\.)*\'/
NUMBER   : /[0-9]+(\.[0-9]+)?/

// ---- Whitespace and comments ---------------------------------------------

%import common.WS
%ignore WS
%ignore /--[^\n]*/
%ignore /\/\*(?s:.*?)\*\//
